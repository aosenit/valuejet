{
  "name": "valuejet",
  "version": "1.0.0",
  "description": "A modern React-based frontend application for ValueJet",
  "private": true,
  "author": "ValueJet Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aosenit/valuejet.git"
  },
  "keywords": [
    "react",
    "typescript",
    "vite",
    "material-ui",
    "turborepo",
    "monorepo"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "clean": "turbo run clean",
    "test": "turbo run test"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=7"
  },
  "packageManager": "pnpm@8.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@tanstack/react-query": "^5.90.2",
    "axios": "^1.12.2",
    "formik": "^2.4.6",
    "react-otp-input": "^3.1.1",
    "sonner": "^2.0.7",
    "yaml": "^2.4.2",
    "zod": "^4.1.11",
    "zod-formik-adapter": "^2.0.0"
  }
}
